# Groq API Key (бесплатный LLM API)
# Получить на: https://console.groq.com/keys
GROQ_API_KEY=your_api_key

# Модель Groq
# llama-3.1-8b-instant - быстрая, 131k токенов/мин (рекомендуется)
# llama-3.3-70b-versatile - умнее, но только 12k токенов/мин
GROQ_MODEL=llama-3.1-8b-instant

# Температура для генерации (0.0 - 1.0)
GROQ_TEMPERATURE=0.7

# Личный сайт/портфолио (опционально)
# Будет добавлен в подпись сопроводительного письма, если включен в enabledContacts
PERSONAL_WEBSITE=https://your-website.dev
